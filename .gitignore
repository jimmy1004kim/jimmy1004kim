# --- Obsidian: device-specific / runtime ---
# 현재 PC의 창 레이아웃·열린 파일 상태 (PC마다 달라야 함)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 플러그인별 사용자 설정 (자격증명·로컬 경로 포함 가능)
.obsidian/plugins/*/data.json

# obsidian-git 런타임 헬퍼 스크립트 (플러그인이 재생성)
.obsidian/plugins/obsidian-git/obsidian_askpass.sh

# Obsidian 내부 휴지통/캐시
.trash/
.obsidian/cache

# --- OS / 에디터 부산물 ---
.DS_Store
Thumbs.db
*.swp
*~
